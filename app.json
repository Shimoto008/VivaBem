{
  "expo": {
    "name": "VivaBem",
    "slug": "vivabem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/VivaBem.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/VivaBem.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/vivabem.png"
      },
      "package": "com.vivabem.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "99c13e1e-d28d-45f0-b880-78f5ef598296"
      }
    }
  }
}
