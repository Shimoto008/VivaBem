{
  "expo": {
    "name": "VivaBem",
    "slug": "vivabem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/VivaBem.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/VivaBem.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo_apk.png"
      },
      "package": "com.vivabem.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAETmPXHsfOtLrCAPyQgIdky7VXNd5kyM8"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O VivaBem precisa da sua localização para encontrar cuidadores próximos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "99c13e1e-d28d-45f0-b880-78f5ef598296"
      }
    }
  }
}