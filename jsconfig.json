{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": []
  },
  "include": ["src/**/*.js", "src/types/**/*.d.ts", "App.js"],
  "exclude": ["node_modules", "android", "ios", ".expo"]
}
